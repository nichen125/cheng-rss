# 统一按 LF 存储与检出。
# 原因：本项目有跨平台 shell 脚本（.sh）与二进制产物，CRLF 会让 Linux 上的
# `#!/bin/sh\r` 直接执行失败。Windows 的编辑器仍可自行显示 CRLF，
# 但 git 里永远是 LF。
* text=auto eol=lf

# ── 明确必须是 LF 的可执行脚本 ──────────────────────────────
*.sh            text eol=lf
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# ── 源码与文档 ──────────────────────────────────────────────
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.css           text eol=lf
*.html          text eol=lf

# ── 二进制：禁止任何换行/编码转换 ───────────────────────────
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.xz            binary
*.zst           binary
*.db            binary
*.db-wal        binary
*.db-shm        binary
*.sbit          binary
*.exe           binary

# ── 构建产物与生成文件：不参与 diff，避免二进制污染 review ──
dist/**         -diff
.toolchain/**   -diff
.cache/**       -diff
node_modules/** -diff

# ── 语言统计：让 GitHub 不把内嵌产物算进仓库语言占比 ────────
dist/**         linguist-generated=true
.toolchain/**   linguist-vendored=true
.cache/**       linguist-vendored=true
