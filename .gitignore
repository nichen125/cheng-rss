# 环境：全部本地化，不进版本库
.toolchain/
.cache/
.npm-global/
.tmp/

# superpowers 工作流的过程产物：设计草稿、实施计划、SDD 台账。
# 它们描述"怎么做到的"，不是"该怎样"—— 定稿的规格进 PLAN.md / docs/specs/，
# 草稿留在 .tmp/（docs/development.md:46-49）。这两条是为了防止
# superpowers 下次创建目录时又把它们混进版本库。
.superpowers/
docs/superpowers/

# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 运行数据：唯一需要备份的东西，但绝不进 git
data/
!data/.gitkeep

# 日志与本地调试
*.log
logs/
coverage/
.nyc_output/

# 数据库（保留迁移 .sql）
*.db
*.db-wal
*.db-shm
*.db-journal
!migrations/*.sql

# 产物二进制
*.sbit
cheng-rss-linux-x64
cheng-rss-windows-x64.exe
cheng-rss-darwin-*

# 编辑器与系统
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 环境变量：可能有 API key
.env
.env.*
!.env.example

# 备份与导出产物
backups/
export-*.tar.zst
export-*.tar.gz

# 测试夹具中的临时文件（HAR 本身要提交）
tests/fixtures/**/*.tmp
tests/fixtures/**/scratch/**

# 并行开发的 worktree 目录，不随仓库分发
.worktrees/
