# 所有资源留在项目内（PLAN §4.3）
#
# 注意：prefix 不能写在这里 —— npm 会直接报错
#   "config prefix cannot be changed from project config"
# 需要全局安装时用环境变量覆盖：
#   npm_config_prefix=./.npm-global npm i -g <pkg>

cache=./.cache/npm

# 供应链安全：允许 lockfile 拒绝不一致的依赖树
engine-strict=true
save-exact=true

# 输出更干净
fund=false
audit=false
